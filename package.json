{
  "name": "goal-cascade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @goal-cascade/web",
    "deploy": "npm run build && npm run deploy -w @goal-cascade/api",
    "preview": "npm run preview --workspace @goal-cascade/api"
  },
  "engines": { "node": ">=22" }
}
